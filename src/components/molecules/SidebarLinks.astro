---
/**
 * 自定义链接侧栏组件：把配置里的 items 渲染成卡片内的链接列表。
 * 站内链接走 url() 统一补 base，站外链接新开标签页。
 * items 为空或未启用时整块不输出（零额外 DOM）。
 */
import Icon from "@iconify/svelte";
import { url } from "@utils/url-utils";
import type { LinksWidget } from "@/types/sidebarConfig";
import WidgetLayout from "./WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	widget?: LinksWidget;
}

const widget = Astro.props.widget;
const title = widget?.title?.trim() || "链接";
const items = (widget?.items ?? []).filter(
	(item) => Boolean(item?.name?.trim()) && Boolean(item?.url?.trim()),
);
---

{
	items.length > 0 && (
		<WidgetLayout
			id="sidebar-links"
			name={title}
			class={Astro.props.class}
			style={Astro.props.style}
		>
			<ul class="sidebar-links">
				{items.map((item) => (
					<li>
						<a
							href={item.external ? item.url : url(item.url)}
							target={item.external ? "_blank" : undefined}
							rel={item.external ? "noopener noreferrer" : undefined}
							class="sidebar-links__item"
						>
							{item.icon && <Icon name={item.icon} class="sidebar-links__icon" />}
							<span class="sidebar-links__name">{item.name}</span>
						</a>
					</li>
				))}
			</ul>
		</WidgetLayout>
	)
}

<style>
.sidebar-links {
	list-style: none;
	margin: 0;
	padding: 0.25rem 0;
	display: flex;
	flex-direction: column;
	gap: 0.125rem;
}

.sidebar-links__item {
	display: flex;
	align-items: center;
	gap: 0.75rem;
	padding: 0.625rem 0.75rem;
	border-radius: var(--shape-corner-full);
	color: var(--on-surface-variant);
	font: var(--m3e-type-body-medium);
	text-decoration: none;
	transition:
		background-color var(--m3e-duration-short) var(--m3e-easing-standard),
		color var(--m3e-duration-short) var(--m3e-easing-standard);
}

.sidebar-links__item:hover {
	background: color-mix(in oklab, var(--primary) 10%, transparent);
	color: var(--primary);
}

.sidebar-links__item:focus-visible {
	outline: 2px solid var(--primary);
	outline-offset: 2px;
}

.sidebar-links__icon {
	width: 1.25rem;
	height: 1.25rem;
	flex-shrink: 0;
}

.sidebar-links__name {
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
}
</style>
